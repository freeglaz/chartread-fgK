+/* -K checkpoint support (freeglaz patch).                                   */
+/* The .ti3 is rewritten after every accepted strip pass, through a temporary */
+/* file that is flushed to disk and then renamed over the real name, so that  */
+/* an interruption leaves either the previous or the new complete file, and   */
+/* -r can resume from it. save_ti3() is made safe to call repeatedly.         */
+
+/* Replace or append a keyword in the first table */
+static void ckpt_set_kword(cgats *ocg, char *ksym, char *kdata) {
+	ocg->add_kword_at(ocg, 0, ocg->find_kword(ocg, 0, ksym), ksym, kdata, NULL);
+}
+
+/* Free all the sets of the first table so that it can be refilled */
+static void ckpt_clear_sets(cgats *ocg) {
+	cgats_table *t = &ocg->t[0];
+	int k, i;
+
+	for (k = 0; k < t->nsets; k++) {
+		for (i = 0; i < t->nfields; i++)
+			ocg->al->free(ocg->al, t->fdata[k][i]);
+		ocg->al->free(ocg->al, t->fdata[k]);
+	}
+	t->nsets = 0;
+}
+
+#if !defined(NT)
+#ifdef F_FULLFSYNC
+/* nz if errno e from F_FULLFSYNC means "not supported here" (and nothing worse). */
+/* EOPNOTSUPP is distinct from ENOTSUP on macOS (102 vs 45) but equal on Linux.   */
+static int ckpt_fullfsync_unsupported(int e) {
+	if (e == ENOTSUP || e == EINVAL)
+		return 1;
+#if defined(EOPNOTSUPP) && EOPNOTSUPP != ENOTSUP
+	if (e == EOPNOTSUPP)
+		return 1;
+#endif
+	return 0;
+}
+#endif
+
+/* Flush an open file or directory to stable storage.                          */
+/* fsync() always; then, where it exists (macOS), F_FULLFSYNC, since fsync()     */
+/* there does not flush the drive cache.                                         */
+/* Return 0 when fully flushed, 1 when fsync() succeeded but F_FULLFSYNC is not  */
+/* supported here (ENOTSUP, EOPNOTSUPP or EINVAL: a REDUCED guarantee that the   */
+/* caller must report), -1 on any other error (errno set).                       */
+static int ckpt_flush_fd(int fd) {
+	if (fsync(fd) != 0)
+		return -1;
+#ifdef F_FULLFSYNC
+	if (fcntl(fd, F_FULLFSYNC) == -1) {
+		if (ckpt_fullfsync_unsupported(errno))
+			return 1;
+		return -1;
+	}
+#endif
+	return 0;
+}
+#endif
+
+/* Durability of a write that succeeded (ckpt_write_atomic() *durab) */
+#define CKPT_DURABLE   0	/* file and directory fully flushed */
+#define CKPT_REDUCED   1	/* F_FULLFSYNC not supported: fsync() only (wmsg says where) */
+#define CKPT_NODIRSYNC 2	/* renamed, but the directory flush failed (wmsg) */
+
+/* Write ocg to outname through outname.tmp, flush, rename, flush the directory. */
+/* Return 0 if outname now holds the new data (*durab and wmsg tell how durably), */
+/* nz on error with a message in emsg (outname is then unchanged).               */
+static int ckpt_write_atomic(cgats *ocg, char *outname, char *emsg, size_t emsgl,
+                             char *wmsg, size_t wmsgl, int *durab) {
+	char tmpname[MAXNAMEL+20];
+	cgatsFile *fp;
+	int rv;
+
+	*durab = CKPT_DURABLE;
+	wmsg[0] = '\000';
+	snprintf(tmpname, sizeof(tmpname), "%s.tmp", outname);
+	/* (Not ocg->write_name(): it ignores the result of the final fclose(), */
+	/*  so a disk full on the last buffer flush would go unnoticed) */
+	if ((fp = new_cgatsFileStd_name(tmpname, "w")) == NULL) {
+		snprintf(emsg, emsgl, "unable to open '%s' for writing", tmpname);
+		return 1;
+	}
+	if ((rv = ocg->write(ocg, fp)) != 0)
+		snprintf(emsg, emsgl, "%s", ocg->e.m);
+	if (fp->del(fp) != 0 && rv == 0) {
+		rv = 1;
+		snprintf(emsg, emsgl, "write error on '%s' (%s)", tmpname, strerror(errno));
+	}
+	if (rv != 0) {
+		remove(tmpname);
+		return 1;
+	}
+#if defined(NT)
+	if (!MoveFileExA(tmpname, outname, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) {
+		snprintf(emsg, emsgl, "replacing '%s' failed (error %lu), readings are in '%s'",
+		         outname, (unsigned long)GetLastError(), tmpname);
+		return 1;
+	}
+#else
+	{
+		int fd, fr = -1, dr = -1, e;
+		char dname[MAXNAMEL+20], *sl;
+
+		if ((fd = open(tmpname, O_RDONLY)) < 0 || (fr = ckpt_flush_fd(fd)) < 0) {
+			e = errno;
+			snprintf(emsg, emsgl, "flushing '%s' failed (%s)", tmpname, strerror(e));
+			if (fd >= 0)
+				close(fd);
+			remove(tmpname);
+			return 1;
+		}
+		close(fd);
+		if (rename(tmpname, outname) != 0) {
+			snprintf(emsg, emsgl, "renaming '%s' failed (%s), readings are in '%s'",
+			         outname, strerror(errno), tmpname);
+			return 1;
+		}
+		/* Make the rename itself durable */
+		strcpy(dname, outname);
+		if ((sl = strrchr(dname, '/')) == NULL)
+			strcpy(dname, ".");
+		else if (sl == dname)
+			dname[1] = '\000';		/* file in "/" */
+		else
+			*sl = '\000';
+		if ((fd = open(dname, O_RDONLY)) < 0 || (dr = ckpt_flush_fd(fd)) < 0) {
+			/* The new file is in place and readable: not an error, but not durable */
+			e = errno;
+			snprintf(wmsg, wmsgl, "flushing directory '%s' failed (%s), the new file may not "
+			         "survive a power loss", dname, strerror(e));
+			if (fd >= 0)
+				close(fd);
+			*durab = CKPT_NODIRSYNC;
+			return 0;
+		}
+		close(fd);
+		if (fr > 0 || dr > 0) {
+			snprintf(wmsg, wmsgl, "F_FULLFSYNC not supported for the %s%s%s, only fsync() done: "
+			         "the drive cache may not be flushed", fr > 0 ? "file" : "",
+			         fr > 0 && dr > 0 ? " and the " : "", dr > 0 ? "directory" : "");
+			*durab = CKPT_REDUCED;
+		}
+	}
+#endif
+	return 0;
+}
